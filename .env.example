# ---------------------------------------------------------------------------
# Perx CRM — environment variables
# Copy to .env and fill in. Only DATABASE_URL and AUTH_SECRET are required to
# run locally; every integration degrades gracefully to a console/dev provider
# when its keys are missing.
# ---------------------------------------------------------------------------

# --- Core ---
# Matches docker-compose.yml
DATABASE_URL="postgresql://perx:perx@localhost:5432/perx_crm"
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Base URL of the app (used in emails, booking links, OAuth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google OAuth (login + calendar connect) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (Resend) ---
# Leave empty to use the console email provider (logs instead of sending)
RESEND_API_KEY=""
EMAIL_FROM="Perx CRM <crm@example.com>"
# Signing secret for Resend webhooks (svix)
RESEND_WEBHOOK_SECRET=""

# --- SMS ---
# TWILIO | LOCAL_GATEWAY | CONSOLE (console logs instead of sending)
SMS_PROVIDER="CONSOLE"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- AI assistant (Ask Perx & Generative canvas) ---
# You can configure the AI provider in the UI instead of here: Settings → AI
# provider (admin only). A key saved there is encrypted at rest and OVERRIDES
# everything below. These env vars are the fallback / default.
#
# Default provider: Anthropic (recommended — best tool-calling, no training
# on your data). Just set the key:
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"
#
# Or use a free / OpenAI-compatible provider instead by setting AI_PROVIDER:
#   GROQ       — free tier; get a key at console.groq.com     -> GROQ_API_KEY
#   GEMINI     — free tier; aistudio.google.com               -> GEMINI_API_KEY
#   OPENROUTER — some ":free" models; openrouter.ai           -> OPENROUTER_API_KEY
#   MISTRAL    — free tier; console.mistral.ai                -> MISTRAL_API_KEY
#   OLLAMA     — self-hosted, no key (http://localhost:11434)
#   OPENAI     — paid; platform.openai.com                    -> OPENAI_API_KEY
#   CUSTOM     — any OpenAI-compatible server: set AI_BASE_URL + AI_MODEL
#
# PRIVACY: free tiers of hosted providers (especially Gemini) may use your
# prompts — i.e. your CRM data — to improve their models. For business data
# prefer Anthropic or self-hosted Ollama.
AI_PROVIDER=""
# Optional overrides (apply to any preset):
AI_MODEL=""
AI_BASE_URL=""
AI_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
MISTRAL_API_KEY=""
OPENAI_API_KEY=""

# --- Google Calendar connect (uses the same GOOGLE_CLIENT_ID/SECRET as login) ---
# Add ${NEXT_PUBLIC_APP_URL}/api/google/callback as an authorized redirect URI in Google Cloud Console

# --- Google Maps (merchant map view + location picker) ---
# Maps JavaScript API key. It's used client-side, so restrict it by HTTP referrer
# in Google Cloud (APIs: Maps JavaScript API + Places API). Without it, the map
# falls back to manual latitude/longitude entry.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Optional: a Map ID for custom styling. Defaults to Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# --- Meeting reminders cron ---
# The /api/cron/reminders job sends a "1 hour before" reminder to attendees + host.
# Set CRON_SECRET to a long random string; the endpoint requires it as a Bearer
# token so only the scheduler can trigger it:
#   Authorization: Bearer <CRON_SECRET>
# On Vercel Hobby (which caps crons at once/day) drive it from an external
# scheduler (e.g. cron-job.org) hitting /api/cron/reminders every 15 min. On Pro,
# add a vercel.json "crons" entry for "*/15 * * * *" instead.
CRON_SECRET=""

# --- Telegram meeting bot ---
# Bot token from @BotFather. Add the bot to your team group and turn OFF its
# Group Privacy so it can read messages. Meetings parsed from group posts are
# created (after an in-chat confirm) on a shared team calendar.
TELEGRAM_BOT_TOKEN=""
# A random string you choose. Telegram echoes it on every update so we can verify
# the request. After deploying with both vars set, visit /api/telegram/set-webhook
# once (signed in as an admin) to register the webhook.
TELEGRAM_WEBHOOK_SECRET=""
# Optional: email of the CRM user whose Google Calendar hosts Telegram-created
# meetings. Defaults to the oldest admin when unset.
TELEGRAM_MEETING_HOST_EMAIL=""
