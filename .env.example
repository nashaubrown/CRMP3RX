# ---------------------------------------------------------------------------
# Perx CRM — environment variables
# Copy to .env and fill in. Only DATABASE_URL and AUTH_SECRET are required to
# run locally; every integration degrades gracefully to a console/dev provider
# when its keys are missing.
# ---------------------------------------------------------------------------

# --- Core ---
# Matches docker-compose.yml
DATABASE_URL="postgresql://perx:perx@localhost:5432/perx_crm"
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Base URL of the app (used in emails, booking links, OAuth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google OAuth (login + calendar connect) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (Resend) ---
# Leave empty to use the console email provider (logs instead of sending)
RESEND_API_KEY=""
EMAIL_FROM="Perx CRM <crm@example.com>"
# Signing secret for Resend webhooks (svix)
RESEND_WEBHOOK_SECRET=""

# --- SMS ---
# TWILIO | LOCAL_GATEWAY | CONSOLE (console logs instead of sending)
SMS_PROVIDER="CONSOLE"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- AI assistant (Anthropic) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
