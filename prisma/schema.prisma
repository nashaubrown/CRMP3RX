// Perx CRM data model.
// Conventions:
//  - All timestamps are stored in UTC (timestamptz); the UI renders Asia/Maldives.
//  - Polymorphic links (Activity, EmailMessage, SmsMessage, AuditLog) use
//    entityType + entityId because Prisma has no native polymorphism; integrity
//    is enforced in the services layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth & users ----------

enum Role {
  ADMIN
  SALES_REP
  // Works the Dev board (tickets against the Merchant Portal / Perx App).
  // Everywhere else the app treats a developer like a rep.
  DEVELOPER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  role          Role      @default(SALES_REP)
  // The single "owner" account. Only the owner may reset another admin's
  // password, or disable/demote another admin — so one compromised admin
  // session can't be used to take over the others.
  isOwner       Boolean   @default(false)
  // Named capability set. Null falls back to the default set. Ignored for
  // admins, who always have every capability.
  permissionSetId String?
  permissionSet   PermissionSet? @relation(fields: [permissionSetId], references: [id], onDelete: SetNull)
  image         String?
  // Public booking page lives at /book/[bookingSlug]
  bookingSlug   String?   @unique
  // When true, the user's home is the AI-composed "Generative" canvas
  generativeUi  Boolean   @default(false)
  // Set when an admin offboards someone: blocks all sign-in, keeps their records.
  disabledAt    DateTime?
  // Adoption tracking. lastLoginAt is stamped by the Auth.js signIn event;
  // lastActiveAt by audit(), so it moves whenever the user actually changes
  // something. Sessions are JWT, so there is no Session row to read this from.
  lastLoginAt   DateTime?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  calendarAccount GoogleCalendarAccount?
  availability    AvailabilitySchedule?

  ownedMerchants Merchant[]     @relation("MerchantOwner")
  ownedContacts  Contact[]      @relation("ContactOwner")
  ownedLeads     Lead[]         @relation("LeadOwner")
  ownedDeals     Deal[]         @relation("DealOwner")
  activities     Activity[]
  sentEmails     EmailMessage[]
  sentSms        SmsMessage[]
  meetings       Meeting[]
  auditLogs      AuditLog[]
  conversations  Conversation[]
  merchantShares MerchantShare[]
  geofences      Geofence[]      @relation("GeofenceOwner")
  apiKeys        ApiKey[]
  canvasViews    CanvasView[]
  commissionsPaid AffiliateCommission[] @relation("CommissionPaidBy")
  assignedTasks   Task[]                @relation("TaskAssignee")
  createdTasks    Task[]                @relation("TaskCreatedBy")
  helpArticlesAuthored HelpArticle[]         @relation("HelpArticleAuthor")
  helpArticlesReviewed HelpArticle[]         @relation("HelpArticleReviewer")
  curatedRewards       CuratedReward[]       @relation("CuratedRewardCreator")
  reportedTickets      DevTicket[]           @relation("DevTicketReporter")
  assignedTickets      DevTicket[]           @relation("DevTicketAssignee")
  ticketComments       DevTicketComment[]    @relation("DevTicketCommentAuthor")
  roadmapSuggestions   RoadmapItem[]         @relation("RoadmapSuggestedBy")
  roadmapVotes         RoadmapVote[]
  roadmapComments      RoadmapComment[]      @relation("RoadmapCommentAuthor")
}

// Personal access tokens for the REST API and the MCP endpoint. Only a
// SHA-256 hash is stored; the full token is shown once at creation. A key
// authenticates as its owner, so all RBAC scoping applies unchanged.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  // First characters of the token (e.g. "perx_3f9a") for display only
  prefix     String
  hashedKey  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Org-wide AI provider configuration for Ask Perx and the Generative canvas,
// set by an admin in Settings. Overrides the .env defaults. Singleton row
// (fixed id). The API key is stored AES-256-GCM encrypted (see lib/crypto),
// never returned to the client.
model AiSetting {
  id          String   @id @default("singleton")
  provider    String
  model       String?
  baseUrl     String?
  apiKeyEnc   String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Global "from" identity for outbound CRM email (singleton). Overrides the
// EMAIL_FROM env fallback. The address's domain must be verified in the email
// provider (Resend) or sends will fail.
model EmailSetting {
  id          String   @id @default("singleton")
  fromName    String?
  fromEmail   String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Auth.js adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Google Calendar connection (separate from Google login OAuth —
// calendar needs offline access + calendar scopes).
model GoogleCalendarAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String
  calendarId   String   @default("primary")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- CRM core ----------

enum MerchantStatus {
  PROSPECT
  ACTIVE
  CHURNED
}

// Collaboration on a merchant. All merchants are org-visible (hybrid model);
// a VIEW share adds the merchant to the collaborator's working set, an EDIT
// share additionally grants editing the merchant/contacts and logging activity.
enum SharePermission {
  VIEW
  EDIT
}

model MerchantShare {
  id         String          @id @default(cuid())
  merchantId String
  merchant   Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission SharePermission @default(VIEW)
  createdAt  DateTime        @default(now())

  @@unique([merchantId, userId])
  @@index([userId])
}

model Merchant {
  id       String         @id @default(cuid())
  name     String
  // MCC-style category, e.g. "Restaurants & Cafés"
  category String?
  status   MerchantStatus @default(PROSPECT)
  website  String?
  phone    String?
  email    String?
  address  String?
  notes    String?

  // Perx-specific fields
  posSystem        String?
  monthlyTxnVolume Int?
  loyaltyLive      Boolean @default(false)
  // Admin-managed option-set value (label), e.g. "Growth"
  subscriptionPlan String?
  // Number of physical branches/outlets
  branches         Int?
  // Flags this merchant as part of the BETA program
  beta             Boolean @default(false)
  // Map location (set via the location picker on the merchant form)
  latitude         Float?
  longitude        Float?

  // Affiliate/referral: who brought this merchant in (earns a commission).
  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  ownerId   String
  owner     User     @relation("MerchantOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts     Contact[]
  contactLinks ContactMerchant[]
  outlets      Outlet[]
  curatedRewards CuratedReward[]
  devTickets   DevTicket[]
  roadmapDemands RoadmapDemand[]
  leads        Lead[]
  deals        Deal[]
  shares       MerchantShare[]
  tasks        Task[]

  @@index([ownerId])
  @@index([status])
  @@index([name])
  @@index([affiliateId])
}

// A referral partner. For every merchant an affiliate brings, they earn a
// commission (a percentage of that merchant's MRR). Managed by admins in
// Settings; selected on the merchant form.
// NOTE: User.isOwner marks the single account allowed to reset another
// admin's password (and to disable or demote another admin). See
// src/services/users.ts.

enum AffiliateApplicationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum PayoutSchedule {
  MONTHLY
  QUARTERLY
  YEARLY
}

// A named bundle of capabilities assigned to sales reps, so access can differ
// between people without inventing a role per person. Admins bypass this
// entirely — they always hold every capability. Resolution for a rep is:
// their own set, else the set flagged isDefault, else the built-in fallback
// in src/services/permissions.ts.
model PermissionSet {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  // Bulk-download any list as CSV (merchants, contacts, deals, leads).
  canExportData      Boolean @default(false)
  // See merchants owned by other reps. When false the rep's lists, search,
  // maps and zones show only their own book plus merchants shared with them.
  canSeeAllMerchants Boolean @default(true)
  // See team-wide totals and the per-rep breakdown on the dashboard.
  canSeeTeamNumbers  Boolean @default(true)

  // Applied to any rep without their own set. Exactly one row carries this.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@index([isDefault])
}

model Affiliate {
  id             String   @id @default(cuid())
  name           String
  // Permanent public referral code (6 chars, confusable characters excluded).
  // Assigned once at creation and never editable — it gets printed, shared
  // and quoted on payouts, so changing one would orphan that history.
  code           String   @unique
  email          String?
  phone          String? // E.164, default region +960
  // Commission as a percentage of the referred merchant's monthly MRR.
  commissionRate Float    @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // --- Application / registration (affiliate portal) ---
  // Legacy admin-created affiliates were backfilled to APPROVED. A draft row
  // (self-registration in progress) is PENDING_REVIEW with appliedAt null;
  // it becomes a real application once appliedAt is set.
  applicationStatus AffiliateApplicationStatus @default(PENDING_REVIEW)
  appliedAt         DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  reviewNote        String? // internal; optional line included in rejection email
  emailVerifiedAt   DateTime?

  // --- Identity (KYC) ---
  idCardNumber  String? // e.g. "A123456"; masked in all affiliate-facing output
  idDocumentKey String? // AffiliateFile id; served to admins only

  // --- Bank details ---
  bankName         String?
  bankAccountName  String?
  bankAccountNoEnc String? // AES-256-GCM via src/lib/crypto; last-4 kept separately
  bankAccountLast4 String? // for masked display without decryption

  // --- Agreement ---
  tcVersion    String? // version string signed, e.g. "2026-08-01"
  tcAcceptedAt DateTime?
  tcAcceptedIp String?
  tcAcceptedUa String?
  signatureKey String? // AffiliateFile id of the latest drawn-signature PNG

  // --- Payouts ---
  payoutSchedule PayoutSchedule @default(MONTHLY) // admin-set at approval

  // --- Portal ---
  emailNotifications Boolean   @default(true)
  lastPortalLoginAt  DateTime?

  merchants     Merchant[]
  commissions   AffiliateCommission[]
  loginTokens   AffiliateLoginToken[]
  sessions      AffiliateSession[]
  referredLeads Lead[]
  files         AffiliateFile[]

  @@index([active])
  @@index([applicationStatus])
}

// One-time tokens for the affiliate portal: magic links, registration email
// codes, draft continuation, bank-change confirmations and application-status
// links — one model, a `purpose` discriminator. Only SHA-256 hashes are stored
// (pattern: ApiKey.hashedKey). Single-use via consumedAt (except DRAFT and
// APPLICATION_STATUS, which stay valid until they expire).
enum AffiliateTokenPurpose {
  LOGIN
  REGISTER_EMAIL
  DRAFT
  BANK_CHANGE
  APPLICATION_STATUS
}

model AffiliateLoginToken {
  id          String                @id @default(cuid())
  affiliateId String
  affiliate   Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  purpose     AffiliateTokenPurpose @default(LOGIN)
  hashedToken String                @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime              @default(now())

  @@index([affiliateId])
  @@index([expiresAt])
}

model AffiliateSession {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  hashedToken String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([affiliateId])
  @@index([expiresAt])
}

enum AffiliateFileKind {
  ID_DOCUMENT
  SIGNATURE
}

// Private uploads from affiliate registration (ID document, drawn signature).
// Stored in Postgres rather than public blob storage so they are genuinely
// private: the only read path is an ADMIN-authenticated CRM route. Volume is
// tiny (a few files per application, ≤10 MB each) so DB storage is fine; the
// storage helper (src/lib/affiliate-files.ts) is the single seam to swap in
// external blob storage later.
model AffiliateFile {
  id          String            @id @default(cuid())
  affiliateId String
  affiliate   Affiliate         @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  kind        AffiliateFileKind
  contentType String
  sizeBytes   Int
  data        Bytes
  // Signature files: which T&C version was signed (prior signatures are kept
  // when terms are re-accepted).
  tcVersion   String?
  createdAt   DateTime          @default(now())

  @@index([affiliateId])
}

// Current affiliate Terms & Conditions text, editable by admins (singleton,
// like EmailSetting). Bumping `version` forces re-acceptance (with a fresh
// signature) on next portal sign-in.
model AffiliateTermsSetting {
  id        String   @id @default("singleton")
  version   String
  bodyHtml  String
  updatedAt DateTime @updatedAt
}

enum CommissionStatus {
  PENDING
  PAID
}

// A recorded monthly commission snapshot for an affiliate — the payout ledger.
// Recording a period freezes the computed amount so past months stay accurate
// even as merchants/pricing change. One row per affiliate per period.
model AffiliateCommission {
  id             String           @id @default(cuid())
  affiliateId    String
  affiliate      Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  period         String // "YYYY-MM"
  amountMvr      Int
  commissionRate Float // rate at snapshot time
  merchantCount  Int // billable merchants counted at snapshot time
  status         CommissionStatus @default(PENDING)
  paidAt         DateTime?
  paidById       String?
  paidBy         User?            @relation("CommissionPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  recordedById   String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([affiliateId, period])
  @@index([period])
  @@index([status])
}

// A physical outlet/branch of a merchant. A merchant can have many; branch
// count and per-location billing derive from these.
model Outlet {
  id         String   @id @default(cuid())
  name       String
  address    String?
  latitude   Float?
  longitude  Float?
  isPrimary  Boolean  @default(false)
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([merchantId])
}

model Contact {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  title     String?
  email     String?
  phone     String? // E.164, default region +960
  isPrimary Boolean @default(false)

  // Home/primary merchant. Additional merchant tags live in ContactMerchant.
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  ownerId    String?
  owner      User?    @relation("ContactOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchantLinks ContactMerchant[]
  leads         Lead[]
  deals         Deal[]
  meetings      Meeting[]
  tasks         Task[]

  @@index([merchantId])
  @@index([ownerId])
}

// Many-to-many tags: which merchants a contact is associated with. Always
// includes the contact's home merchant (Contact.merchantId) plus any extras.
model ContactMerchant {
  contactId  String
  merchantId String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([contactId, merchantId])
  @@index([merchantId])
  @@index([contactId])
}

// Admin-managed dropdown values (option sets), e.g. merchant Category and
// Subscription Plan. Keeping the selected value as a label string on the
// record means archiving/renaming an option never orphans existing data.
enum OptionSetKey {
  MERCHANT_CATEGORY
  SUBSCRIPTION_PLAN
}

enum GeofenceType {
  TERRITORY
  CAMPAIGN
}

// ---------- Curated rewards ----------
//
// Merchants freeze at the portal's blank "create a reward" form, so the team
// curates ideas for them here. CRM-only on purpose: a curated reward is a
// pitch, not a live reward — the merchant still creates the real thing in the
// Merchant Portal themselves. Nothing here syncs anywhere.

// The reward mechanics the Perx portal supports. Mirrored, not invented: a
// curated idea a merchant can't actually build is worse than no idea.
enum RewardMechanic {
  STAMP_CARD // collect N -> get X
  DISCOUNT // % or MVR off
  FREE_ITEM // free add-on with a purchase
  TIME_LIMITED // time-boxed special, e.g. double points Fridays
}

// Where a curated reward came from. Drives the AI-refresh replacement rule:
// STARTER and AI ideas that are still untouched may be swapped for a better
// set; LIBRARY (rep-picked) and CUSTOM (rep-written) are never auto-removed.
enum CuratedRewardSource {
  STARTER // auto-curated when the merchant was created/backfilled
  LIBRARY // a rep pulled it from the library
  CUSTOM // a rep wrote it by hand
  AI // written by the AI for this specific merchant
}

enum CuratedRewardStatus {
  IDEA // curated, merchant hasn't seen it
  PITCHED // shown to the merchant
  ACCEPTED // merchant took it (created it in the portal)
  DECLINED // merchant passed
}

// Admin-maintained library of reward ideas, tagged by merchant category so
// "buy 5 get 1 free" is written once, not once per café. category is an
// option-set label (MERCHANT_CATEGORY); null = fits any category.
model RewardTemplate {
  id          String         @id @default(cuid())
  title       String
  // Merchant-facing wording, ready to read out in a pitch.
  description String?
  mechanic    RewardMechanic
  category    String?
  archived    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  rewards CuratedReward[]

  @@index([category])
}

// A reward idea curated for one specific merchant. Copies title/description
// from its template (when it has one) so editing the library never rewrites
// what was already pitched to someone.
model CuratedReward {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  // Provenance only — which library idea this started from.
  templateId String?
  template   RewardTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  title       String
  description String?
  mechanic    RewardMechanic
  status      CuratedRewardStatus @default(IDEA)
  source      CuratedRewardSource @default(CUSTOM)
  // Rep notes from the conversation ("wants it weekends only").
  notes       String?

  createdById String
  createdBy   User   @relation("CuratedRewardCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([templateId])
}enum GeofenceShape {
  POLYGON
  CIRCLE
}

// A drawn zone on the map. POLYGON stores its vertices in `points`; CIRCLE
// stores a single center point in `points` plus `radiusM`.
model Geofence {
  id        String        @id @default(cuid())
  name      String
  type      GeofenceType  @default(TERRITORY)
  shape     GeofenceShape
  color     String        @default("#16a34a")
  // [{ lat, lng }, ...] — polygon vertices, or a single center for circles.
  points    Json
  radiusM   Int? // circle radius in meters
  offer     String? // optional campaign offer/note
  ownerId   String? // assigned rep
  owner     User?         @relation("GeofenceOwner", fields: [ownerId], references: [id])
  createdById String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([type])
  @@index([ownerId])
}

model OptionItem {
  id        String       @id @default(cuid())
  setKey    OptionSetKey
  label     String
  sortOrder Int          @default(0)
  archived  Boolean      @default(false)
  // Billing (subscription-plan option set only): monthly price in MVR and
  // whether it's charged per branch/location.
  priceMvr    Int?
  perLocation Boolean    @default(false)
  createdAt DateTime     @default(now())

  @@unique([setKey, label])
  @@index([setKey])
}

// ---------- Task tracker ----------

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// A tracked to-do. Standalone or optionally linked to a merchant/contact/deal.
// Distinct from Activity (the record timeline): tasks carry status, priority
// and an assignee, and drive the Tasks tracker board/list.
model Task {
  id          String       @id @default(cuid())
  title       String
  notes       String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime?
  // Board ordering within a status column.
  position    Int          @default(0)
  completedAt DateTime?

  assigneeId  String
  assignee    User   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId])
  @@index([status])
  @@index([dueAt])
  @@index([merchantId])
  @@index([contactId])
  @@index([dealId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
}

model Lead {
  id     String     @id @default(cuid())
  source String
  status LeadStatus @default(NEW)
  score  Int        @default(0)

  // Raw capture fields (public form) — may exist before a Contact/Merchant does
  name    String?
  email   String?
  phone   String?
  company String?
  message String?

  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  ownerId    String?
  owner      User?     @relation("LeadOwner", fields: [ownerId], references: [id])

  // Referral attribution: which affiliate brought this lead in (via the
  // capture form's ?ref= code or the portal's submit-a-referral form).
  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([merchantId])
  @@index([contactId])
  @@index([affiliateId])
}

enum DealStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum Currency {
  MVR
  USD
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  stage             DealStage @default(NEW)
  value             Decimal   @db.Decimal(14, 2)
  currency          Currency  @default(MVR)
  expectedCloseDate DateTime?
  lostReason        String?
  closedAt          DateTime?
  // Board ordering within a stage column
  position          Int       @default(0)

  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId    String
  owner      User     @relation("DealOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([ownerId])
  @@index([stage])
  @@index([merchantId])
  @@index([contactId])
  @@index([expectedCloseDate])
}

// ---------- Activities & polymorphic links ----------

enum EntityType {
  MERCHANT
  CONTACT
  DEAL
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  SMS
  MEETING
  TASK
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  subject     String
  body        String?
  dueAt       DateTime?
  completedAt DateTime?

  entityType EntityType
  entityId   String

  // Set when this activity mirrors a scheduled Meeting (cancelling the
  // meeting removes the timeline entry).
  meetingId String?  @unique
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([ownerId])
  @@index([dueAt])
  @@index([type])
}

// ---------- Messaging ----------

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  BOUNCED
  FAILED
}

model EmailMessage {
  id         String      @id @default(cuid())
  to         String
  from       String
  subject    String
  html       String
  status     EmailStatus @default(QUEUED)
  providerId String? // Resend message id (webhook correlation)
  error      String?

  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  entityType EntityType?
  entityId   String?

  sentById String
  sentBy   User   @relation(fields: [sentById], references: [id])

  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([entityType, entityId])
  @@index([providerId])
  @@index([sentById])
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum SmsProviderKind {
  TWILIO
  LOCAL_GATEWAY
  CONSOLE
}

model SmsMessage {
  id         String          @id @default(cuid())
  to         String // E.164
  body       String
  status     SmsStatus       @default(QUEUED)
  provider   SmsProviderKind
  providerId String? // Twilio SID etc. (status-callback correlation)
  error      String?

  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  entityType EntityType?
  entityId   String?

  sentById String
  sentBy   User   @relation(fields: [sentById], references: [id])

  sentAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([entityType, entityId])
  @@index([providerId])
  @@index([sentById])
}

// STOP-keyword suppression list
model SmsOptOut {
  id        String   @id @default(cuid())
  phone     String   @unique // E.164
  createdAt DateTime @default(now())
}

enum MessageChannel {
  EMAIL
  SMS
}

model MessageTemplate {
  id      String         @id @default(cuid())
  name    String
  channel MessageChannel
  subject String? // email only
  body    String // supports {{merge_vars}}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emails EmailMessage[]
  sms    SmsMessage[]
}

// ---------- Scheduling ----------

model AvailabilitySchedule {
  id               String @id @default(cuid())
  userId           String @unique
  timezone         String @default("Indian/Maldives")
  slotDurationMins Int    @default(30)
  bufferMins       Int    @default(0)

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules AvailabilityRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AvailabilityRule {
  id         String @id @default(cuid())
  scheduleId String
  dayOfWeek  Int // 0 = Sunday … 6 = Saturday
  // Minutes from midnight in the schedule's timezone
  startMinutes Int
  endMinutes   Int

  schedule AvailabilitySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

enum MeetingStatus {
  CONFIRMED
  CANCELLED
}

model Meeting {
  id            String        @id @default(cuid())
  hostUserId    String
  host          User          @relation(fields: [hostUserId], references: [id])
  contactId     String?
  contact       Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title         String
  notes         String?
  bookerName    String
  bookerEmail   String
  bookerPhone   String?
  startAt       DateTime
  endAt         DateTime
  googleEventId String?
  googleMeetUrl String?
  status        MeetingStatus @default(CONFIRMED)

  // Set when the "1 hour before" reminder has been sent, so the cron never
  // double-sends.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]

  @@index([hostUserId, startAt])
  @@index([contactId])
  @@index([googleEventId])
  @@index([status, reminderSentAt, startAt])
}

enum TelegramPendingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TelegramActionKind {
  MERCHANT
  CONTACT
  DEAL
  TASK
}

// The default merchant for a Telegram chat, so create commands can attach
// without re-naming it (set with /use).
model TelegramChatDefault {
  chatId       String   @id
  merchantId   String
  merchantName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Maps a bot message (that showed a record) back to the record, so a user can
// reply to it and run an action (/move, /done, /log, …).
model TelegramMessageRef {
  chatId     String
  messageId  String
  entityType String // MERCHANT | CONTACT | DEAL | TASK
  entityId   String
  createdAt  DateTime @default(now())

  @@id([chatId, messageId])
}

// Links a Telegram user to a CRM user (via /link), so /mine and /assign me work.
// The group chat that hears every dev-ticket event. Set from Telegram itself
// (/devhere in the group), so nobody has to dig chat ids out of Vercel.
// Singleton: one dev feed per deployment.
model TelegramDevFeed {
  id          String   @id @default("singleton")
  chatId      String
  chatTitle   String?
  enabledById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model TelegramUserLink {
  telegramUserId String   @id
  crmUserId      String
  createdAt      DateTime @default(now())
}

// An in-progress guided command flow for one user in one chat. Each subsequent
// plain message advances the flow until it has enough to build a pending action.
model TelegramConvoState {
  chatId    String
  userId    String
  flow      String
  step      Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([chatId, userId])
}

// A create-record action (merchant or contact) parsed from a Telegram post,
// awaiting an in-chat confirmation tap. payload holds the validated fields.
model TelegramPendingAction {
  id                    String                @id @default(cuid())
  chatId                String
  kind                  TelegramActionKind
  payload               Json
  summary               String
  status                TelegramPendingStatus @default(PENDING)
  recordId              String?
  confirmationMessageId String?
  createdByName         String?
  createdAt             DateTime              @default(now())

  @@index([status, createdAt])
}

// A meeting parsed from a Telegram group post, awaiting an in-chat
// confirmation tap before it becomes a real Meeting + calendar event.
model TelegramPendingMeeting {
  id                    String                @id @default(cuid())
  chatId                String
  merchantId            String
  merchantName          String
  title                 String
  startAt               DateTime
  durationMins          Int                   @default(30)
  status                TelegramPendingStatus @default(PENDING)
  meetingId             String?
  confirmationMessageId String?
  createdByName         String?
  createdAt             DateTime              @default(now())

  @@index([status, createdAt])
}

// ---------- Audit & AI assistant ----------

model AuditLog {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // e.g. "merchant.create", "deal.update", "assistant.tool_call"
  action     String
  entityType String
  entityId   String
  // Merchant this event rolls up to (plain column, no FK: history must
  // survive the merchant's deletion). Set for merchant/contact/share/deal
  // and activity events.
  merchantId String?
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([merchantId, createdAt])
}

// ---------- Dev tickets ----------
//
// A Jira-shaped board inside the CRM: reps file what merchants hit in the
// Merchant Portal / Perx App, developers work the queue, and every ticket can
// point at the merchant who reported it — which Jira never knows.

enum DevTicketType {
  BUG
  FEATURE
  IMPROVEMENT
}

enum DevProduct {
  MERCHANT_PORTAL
  PERX_APP
  CRM
}

enum DevTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Five working states plus a terminal no. BACKLOG = filed, not yet accepted;
// TODO = the devs agreed to do it; TESTING = the reporter verifies the fix
// before it counts as DONE. Deliberately no separate code-review column.
enum DevTicketStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  TESTING
  DONE
  WONT_DO
}

model DevTicket {
  id     String @id @default(cuid())
  // Human handle: shown as PERX-<number>. Assigned by the database so two
  // simultaneous filings can't collide.
  number Int    @unique @default(autoincrement())

  title       String
  description String?
  type        DevTicketType
  product     DevProduct
  priority    DevTicketPriority @default(MEDIUM)
  status      DevTicketStatus   @default(BACKLOG)
  // Ordering within a board column.
  position    Int               @default(0)

  // The merchant who reported/is affected — the CRM-native edge over Jira.
  // SetNull: tickets outlive the merchants that inspired them.
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  reporterId String
  reporter   User    @relation("DevTicketReporter", fields: [reporterId], references: [id])
  assigneeId String?
  assignee   User?   @relation("DevTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // The roadmap feature this ticket implements. SetNull: the work record
  // outlives a deleted roadmap item.
  roadmapItemId String?
  roadmapItem   RoadmapItem? @relation(fields: [roadmapItemId], references: [id], onDelete: SetNull)

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  comments    DevTicketComment[]
  attachments DevTicketAttachment[]

  @@index([status, position])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([merchantId])
  @@index([roadmapItemId])
}

model DevTicketComment {
  id       String    @id @default(cuid())
  ticketId String
  ticket   DevTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author   User      @relation("DevTicketCommentAuthor", fields: [authorId], references: [id])
  body     String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// Screenshots and small files on a ticket. Stored in Postgres like affiliate
// uploads: private by default, served through an authenticated route, and
// swappable for blob storage later without touching callers.
model DevTicketAttachment {
  id           String    @id @default(cuid())
  ticketId     String
  ticket       DevTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename     String
  contentType  String
  sizeBytes    Int
  data         Bytes
  uploadedById String
  createdAt    DateTime  @default(now())

  @@index([ticketId])
}

// ---------- Roadmap ----------
//
// The idea's story, from suggestion to shipped. Deliberately NOT a second
// work tracker: once an item is being built it links to the DevTickets that
// carry the work, and its progress rolls up from the board — status is never
// typed in twice.

enum RoadmapStage {
  SUGGESTED
  CONSIDERING
  PLANNED
  IN_DEVELOPMENT // set automatically when a dev ticket is linked
  SHIPPED
  DECLINED
}

enum RoadmapScore {
  LOW
  MEDIUM
  HIGH
}

model RoadmapItem {
  id          String       @id @default(cuid())
  title       String
  description String?
  stage       RoadmapStage @default(SUGGESTED)
  product     DevProduct
  // MoSCoW-ish planning signals, optional by design.
  effort      RoadmapScore?
  impact      RoadmapScore?

  suggestedById String
  suggestedBy   User   @relation("RoadmapSuggestedBy", fields: [suggestedById], references: [id])

  shippedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  votes    RoadmapVote[]
  demands  RoadmapDemand[]
  comments RoadmapComment[]
  tickets  DevTicket[]

  @@index([stage])
  @@index([product])
}

// One tap per teammate per idea.
model RoadmapVote {
  itemId    String
  item      RoadmapItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([itemId, userId])
}

// A merchant who asked for this feature — the demand signal, and the call
// list on the day it ships.
model RoadmapDemand {
  id         String      @id @default(cuid())
  itemId     String
  item       RoadmapItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  merchantId String
  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  // What they actually said ("would pay extra for this").
  note       String?
  addedById  String
  createdAt  DateTime    @default(now())

  @@unique([itemId, merchantId])
  @@index([merchantId])
}

model RoadmapComment {
  id        String      @id @default(cuid())
  itemId    String
  item      RoadmapItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation("RoadmapCommentAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime    @default(now())

  @@index([itemId])
}

enum ChatRole {
  USER
  ASSISTANT
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId])
}

// A generated "AI-composed view" from the Generative UI canvas: the user's
// prompt and the validated view spec the model produced. Kept as a per-user
// history (like Conversation) so views can be reopened.
model CanvasView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    String
  title     String
  spec      Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String
  toolCalls      Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ---------- Help Center (public docs CMS) ----------
// Articles are written in the CRM with a rich-text editor (Plate JSON),
// go through review (SALES_REP submits, ADMIN approves), and the published
// copy is served to the public help site via /api/help/published.
// Working copy (contentJson/contentHtml) is separate from the live copy
// (publishedJson/publishedHtml) so edits never take the live article down.

enum HelpArticleStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

model HelpCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  icon        String   @default("chart")
  order       Int      @default(99)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles HelpArticle[]
}

model HelpArticle {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String            @default("")
  order       Int               @default(99)
  status      HelpArticleStatus @default(DRAFT)

  categoryId String
  category   HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Working copy — what the editor edits.
  contentJson Json
  contentHtml String @default("")

  // Live copy — what the public site renders. Set on publish.
  publishedTitle       String?
  publishedDescription String?
  publishedJson        Json?
  publishedHtml        String?

  authorId   String?
  author     User?   @relation("HelpArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewerId String?
  reviewer   User?   @relation("HelpArticleReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote String?

  submittedAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([status])
}

model HelpSetting {
  id                  String   @id @default("singleton")
  netlifyBuildHookUrl String?
  siteUrl             String?
  updatedAt           DateTime @updatedAt
}
