// Perx CRM data model.
// Conventions:
//  - All timestamps are stored in UTC (timestamptz); the UI renders Asia/Maldives.
//  - Polymorphic links (Activity, EmailMessage, SmsMessage, AuditLog) use
//    entityType + entityId because Prisma has no native polymorphism; integrity
//    is enforced in the services layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth & users ----------

enum Role {
  ADMIN
  SALES_REP
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  role          Role      @default(SALES_REP)
  image         String?
  // Public booking page lives at /book/[bookingSlug]
  bookingSlug   String?   @unique
  // When true, the user's home is the AI-composed "Generative" canvas
  generativeUi  Boolean   @default(false)
  // Set when an admin offboards someone: blocks all sign-in, keeps their records.
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  calendarAccount GoogleCalendarAccount?
  availability    AvailabilitySchedule?

  ownedMerchants Merchant[]     @relation("MerchantOwner")
  ownedContacts  Contact[]      @relation("ContactOwner")
  ownedLeads     Lead[]         @relation("LeadOwner")
  ownedDeals     Deal[]         @relation("DealOwner")
  activities     Activity[]
  sentEmails     EmailMessage[]
  sentSms        SmsMessage[]
  meetings       Meeting[]
  auditLogs      AuditLog[]
  conversations  Conversation[]
  merchantShares MerchantShare[]
  geofences      Geofence[]      @relation("GeofenceOwner")
  apiKeys        ApiKey[]
  canvasViews    CanvasView[]
  commissionsPaid AffiliateCommission[] @relation("CommissionPaidBy")
  assignedTasks   Task[]                @relation("TaskAssignee")
  createdTasks    Task[]                @relation("TaskCreatedBy")
  helpArticlesAuthored HelpArticle[]         @relation("HelpArticleAuthor")
  helpArticlesReviewed HelpArticle[]         @relation("HelpArticleReviewer")
}

// Personal access tokens for the REST API and the MCP endpoint. Only a
// SHA-256 hash is stored; the full token is shown once at creation. A key
// authenticates as its owner, so all RBAC scoping applies unchanged.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  // First characters of the token (e.g. "perx_3f9a") for display only
  prefix     String
  hashedKey  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Org-wide AI provider configuration for Ask Perx and the Generative canvas,
// set by an admin in Settings. Overrides the .env defaults. Singleton row
// (fixed id). The API key is stored AES-256-GCM encrypted (see lib/crypto),
// never returned to the client.
model AiSetting {
  id          String   @id @default("singleton")
  provider    String
  model       String?
  baseUrl     String?
  apiKeyEnc   String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Global "from" identity for outbound CRM email (singleton). Overrides the
// EMAIL_FROM env fallback. The address's domain must be verified in the email
// provider (Resend) or sends will fail.
model EmailSetting {
  id          String   @id @default("singleton")
  fromName    String?
  fromEmail   String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Auth.js adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Google Calendar connection (separate from Google login OAuth —
// calendar needs offline access + calendar scopes).
model GoogleCalendarAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String
  calendarId   String   @default("primary")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- CRM core ----------

enum MerchantStatus {
  PROSPECT
  ACTIVE
  CHURNED
}

// Collaboration on a merchant. All merchants are org-visible (hybrid model);
// a VIEW share adds the merchant to the collaborator's working set, an EDIT
// share additionally grants editing the merchant/contacts and logging activity.
enum SharePermission {
  VIEW
  EDIT
}

model MerchantShare {
  id         String          @id @default(cuid())
  merchantId String
  merchant   Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission SharePermission @default(VIEW)
  createdAt  DateTime        @default(now())

  @@unique([merchantId, userId])
  @@index([userId])
}

model Merchant {
  id       String         @id @default(cuid())
  name     String
  // MCC-style category, e.g. "Restaurants & Cafés"
  category String?
  status   MerchantStatus @default(PROSPECT)
  website  String?
  phone    String?
  email    String?
  address  String?
  notes    String?

  // Perx-specific fields
  posSystem        String?
  monthlyTxnVolume Int?
  loyaltyLive      Boolean @default(false)
  // Admin-managed option-set value (label), e.g. "Growth"
  subscriptionPlan String?
  // Number of physical branches/outlets
  branches         Int?
  // Flags this merchant as part of the BETA program
  beta             Boolean @default(false)
  // Map location (set via the location picker on the merchant form)
  latitude         Float?
  longitude        Float?

  // Affiliate/referral: who brought this merchant in (earns a commission).
  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  ownerId   String
  owner     User     @relation("MerchantOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts     Contact[]
  contactLinks ContactMerchant[]
  outlets      Outlet[]
  leads        Lead[]
  deals        Deal[]
  shares       MerchantShare[]
  tasks        Task[]

  @@index([ownerId])
  @@index([status])
  @@index([name])
  @@index([affiliateId])
}

// A referral partner. For every merchant an affiliate brings, they earn a
// commission (a percentage of that merchant's MRR). Managed by admins in
// Settings; selected on the merchant form.
model Affiliate {
  id             String   @id @default(cuid())
  name           String
  email          String?
  phone          String? // E.164, default region +960
  // Commission as a percentage of the referred merchant's monthly MRR.
  commissionRate Float    @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  merchants   Merchant[]
  commissions AffiliateCommission[]

  @@index([active])
}

enum CommissionStatus {
  PENDING
  PAID
}

// A recorded monthly commission snapshot for an affiliate — the payout ledger.
// Recording a period freezes the computed amount so past months stay accurate
// even as merchants/pricing change. One row per affiliate per period.
model AffiliateCommission {
  id             String           @id @default(cuid())
  affiliateId    String
  affiliate      Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  period         String // "YYYY-MM"
  amountMvr      Int
  commissionRate Float // rate at snapshot time
  merchantCount  Int // billable merchants counted at snapshot time
  status         CommissionStatus @default(PENDING)
  paidAt         DateTime?
  paidById       String?
  paidBy         User?            @relation("CommissionPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  recordedById   String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([affiliateId, period])
  @@index([period])
  @@index([status])
}

// A physical outlet/branch of a merchant. A merchant can have many; branch
// count and per-location billing derive from these.
model Outlet {
  id         String   @id @default(cuid())
  name       String
  address    String?
  latitude   Float?
  longitude  Float?
  isPrimary  Boolean  @default(false)
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([merchantId])
}

model Contact {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  title     String?
  email     String?
  phone     String? // E.164, default region +960
  isPrimary Boolean @default(false)

  // Home/primary merchant. Additional merchant tags live in ContactMerchant.
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  ownerId    String?
  owner      User?    @relation("ContactOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchantLinks ContactMerchant[]
  leads         Lead[]
  deals         Deal[]
  meetings      Meeting[]
  tasks         Task[]

  @@index([merchantId])
  @@index([ownerId])
}

// Many-to-many tags: which merchants a contact is associated with. Always
// includes the contact's home merchant (Contact.merchantId) plus any extras.
model ContactMerchant {
  contactId  String
  merchantId String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([contactId, merchantId])
  @@index([merchantId])
  @@index([contactId])
}

// Admin-managed dropdown values (option sets), e.g. merchant Category and
// Subscription Plan. Keeping the selected value as a label string on the
// record means archiving/renaming an option never orphans existing data.
enum OptionSetKey {
  MERCHANT_CATEGORY
  SUBSCRIPTION_PLAN
}

enum GeofenceType {
  TERRITORY
  CAMPAIGN
}

enum GeofenceShape {
  POLYGON
  CIRCLE
}

// A drawn zone on the map. POLYGON stores its vertices in `points`; CIRCLE
// stores a single center point in `points` plus `radiusM`.
model Geofence {
  id        String        @id @default(cuid())
  name      String
  type      GeofenceType  @default(TERRITORY)
  shape     GeofenceShape
  color     String        @default("#16a34a")
  // [{ lat, lng }, ...] — polygon vertices, or a single center for circles.
  points    Json
  radiusM   Int? // circle radius in meters
  offer     String? // optional campaign offer/note
  ownerId   String? // assigned rep
  owner     User?         @relation("GeofenceOwner", fields: [ownerId], references: [id])
  createdById String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([type])
  @@index([ownerId])
}

model OptionItem {
  id        String       @id @default(cuid())
  setKey    OptionSetKey
  label     String
  sortOrder Int          @default(0)
  archived  Boolean      @default(false)
  // Billing (subscription-plan option set only): monthly price in MVR and
  // whether it's charged per branch/location.
  priceMvr    Int?
  perLocation Boolean    @default(false)
  createdAt DateTime     @default(now())

  @@unique([setKey, label])
  @@index([setKey])
}

// ---------- Task tracker ----------

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// A tracked to-do. Standalone or optionally linked to a merchant/contact/deal.
// Distinct from Activity (the record timeline): tasks carry status, priority
// and an assignee, and drive the Tasks tracker board/list.
model Task {
  id          String       @id @default(cuid())
  title       String
  notes       String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime?
  // Board ordering within a status column.
  position    Int          @default(0)
  completedAt DateTime?

  assigneeId  String
  assignee    User   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId])
  @@index([status])
  @@index([dueAt])
  @@index([merchantId])
  @@index([contactId])
  @@index([dealId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
}

model Lead {
  id     String     @id @default(cuid())
  source String
  status LeadStatus @default(NEW)
  score  Int        @default(0)

  // Raw capture fields (public form) — may exist before a Contact/Merchant does
  name    String?
  email   String?
  phone   String?
  company String?
  message String?

  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  ownerId    String?
  owner      User?     @relation("LeadOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([merchantId])
  @@index([contactId])
}

enum DealStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum Currency {
  MVR
  USD
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  stage             DealStage @default(NEW)
  value             Decimal   @db.Decimal(14, 2)
  currency          Currency  @default(MVR)
  expectedCloseDate DateTime?
  lostReason        String?
  closedAt          DateTime?
  // Board ordering within a stage column
  position          Int       @default(0)

  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId    String
  owner      User     @relation("DealOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([ownerId])
  @@index([stage])
  @@index([merchantId])
  @@index([contactId])
  @@index([expectedCloseDate])
}

// ---------- Activities & polymorphic links ----------

enum EntityType {
  MERCHANT
  CONTACT
  DEAL
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  SMS
  MEETING
  TASK
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  subject     String
  body        String?
  dueAt       DateTime?
  completedAt DateTime?

  entityType EntityType
  entityId   String

  // Set when this activity mirrors a scheduled Meeting (cancelling the
  // meeting removes the timeline entry).
  meetingId String?  @unique
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([ownerId])
  @@index([dueAt])
  @@index([type])
}

// ---------- Messaging ----------

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  BOUNCED
  FAILED
}

model EmailMessage {
  id         String      @id @default(cuid())
  to         String
  from       String
  subject    String
  html       String
  status     EmailStatus @default(QUEUED)
  providerId String? // Resend message id (webhook correlation)
  error      String?

  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  entityType EntityType?
  entityId   String?

  sentById String
  sentBy   User   @relation(fields: [sentById], references: [id])

  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([entityType, entityId])
  @@index([providerId])
  @@index([sentById])
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum SmsProviderKind {
  TWILIO
  LOCAL_GATEWAY
  CONSOLE
}

model SmsMessage {
  id         String          @id @default(cuid())
  to         String // E.164
  body       String
  status     SmsStatus       @default(QUEUED)
  provider   SmsProviderKind
  providerId String? // Twilio SID etc. (status-callback correlation)
  error      String?

  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  entityType EntityType?
  entityId   String?

  sentById String
  sentBy   User   @relation(fields: [sentById], references: [id])

  sentAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([entityType, entityId])
  @@index([providerId])
  @@index([sentById])
}

// STOP-keyword suppression list
model SmsOptOut {
  id        String   @id @default(cuid())
  phone     String   @unique // E.164
  createdAt DateTime @default(now())
}

enum MessageChannel {
  EMAIL
  SMS
}

model MessageTemplate {
  id      String         @id @default(cuid())
  name    String
  channel MessageChannel
  subject String? // email only
  body    String // supports {{merge_vars}}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emails EmailMessage[]
  sms    SmsMessage[]
}

// ---------- Scheduling ----------

model AvailabilitySchedule {
  id               String @id @default(cuid())
  userId           String @unique
  timezone         String @default("Indian/Maldives")
  slotDurationMins Int    @default(30)
  bufferMins       Int    @default(0)

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules AvailabilityRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AvailabilityRule {
  id         String @id @default(cuid())
  scheduleId String
  dayOfWeek  Int // 0 = Sunday … 6 = Saturday
  // Minutes from midnight in the schedule's timezone
  startMinutes Int
  endMinutes   Int

  schedule AvailabilitySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

enum MeetingStatus {
  CONFIRMED
  CANCELLED
}

model Meeting {
  id            String        @id @default(cuid())
  hostUserId    String
  host          User          @relation(fields: [hostUserId], references: [id])
  contactId     String?
  contact       Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title         String
  notes         String?
  bookerName    String
  bookerEmail   String
  bookerPhone   String?
  startAt       DateTime
  endAt         DateTime
  googleEventId String?
  googleMeetUrl String?
  status        MeetingStatus @default(CONFIRMED)

  // Set when the "1 hour before" reminder has been sent, so the cron never
  // double-sends.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]

  @@index([hostUserId, startAt])
  @@index([contactId])
  @@index([googleEventId])
  @@index([status, reminderSentAt, startAt])
}

enum TelegramPendingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TelegramActionKind {
  MERCHANT
  CONTACT
  DEAL
  TASK
}

// The default merchant for a Telegram chat, so create commands can attach
// without re-naming it (set with /use).
model TelegramChatDefault {
  chatId       String   @id
  merchantId   String
  merchantName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Maps a bot message (that showed a record) back to the record, so a user can
// reply to it and run an action (/move, /done, /log, …).
model TelegramMessageRef {
  chatId     String
  messageId  String
  entityType String // MERCHANT | CONTACT | DEAL | TASK
  entityId   String
  createdAt  DateTime @default(now())

  @@id([chatId, messageId])
}

// Links a Telegram user to a CRM user (via /link), so /mine and /assign me work.
model TelegramUserLink {
  telegramUserId String   @id
  crmUserId      String
  createdAt      DateTime @default(now())
}

// An in-progress guided command flow for one user in one chat. Each subsequent
// plain message advances the flow until it has enough to build a pending action.
model TelegramConvoState {
  chatId    String
  userId    String
  flow      String
  step      Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([chatId, userId])
}

// A create-record action (merchant or contact) parsed from a Telegram post,
// awaiting an in-chat confirmation tap. payload holds the validated fields.
model TelegramPendingAction {
  id                    String                @id @default(cuid())
  chatId                String
  kind                  TelegramActionKind
  payload               Json
  summary               String
  status                TelegramPendingStatus @default(PENDING)
  recordId              String?
  confirmationMessageId String?
  createdByName         String?
  createdAt             DateTime              @default(now())

  @@index([status, createdAt])
}

// A meeting parsed from a Telegram group post, awaiting an in-chat
// confirmation tap before it becomes a real Meeting + calendar event.
model TelegramPendingMeeting {
  id                    String                @id @default(cuid())
  chatId                String
  merchantId            String
  merchantName          String
  title                 String
  startAt               DateTime
  durationMins          Int                   @default(30)
  status                TelegramPendingStatus @default(PENDING)
  meetingId             String?
  confirmationMessageId String?
  createdByName         String?
  createdAt             DateTime              @default(now())

  @@index([status, createdAt])
}

// ---------- Audit & AI assistant ----------

model AuditLog {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // e.g. "merchant.create", "deal.update", "assistant.tool_call"
  action     String
  entityType String
  entityId   String
  // Merchant this event rolls up to (plain column, no FK: history must
  // survive the merchant's deletion). Set for merchant/contact/share/deal
  // and activity events.
  merchantId String?
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([merchantId, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId])
}

// A generated "AI-composed view" from the Generative UI canvas: the user's
// prompt and the validated view spec the model produced. Kept as a per-user
// history (like Conversation) so views can be reopened.
model CanvasView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    String
  title     String
  spec      Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String
  toolCalls      Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ---------- Help Center (public docs CMS) ----------
// Articles are written in the CRM with a rich-text editor (Plate JSON),
// go through review (SALES_REP submits, ADMIN approves), and the published
// copy is served to the public help site via /api/help/published.
// Working copy (contentJson/contentHtml) is separate from the live copy
// (publishedJson/publishedHtml) so edits never take the live article down.

enum HelpArticleStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

model HelpCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  icon        String   @default("chart")
  order       Int      @default(99)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles HelpArticle[]
}

model HelpArticle {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String            @default("")
  order       Int               @default(99)
  status      HelpArticleStatus @default(DRAFT)

  categoryId String
  category   HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Working copy — what the editor edits.
  contentJson Json
  contentHtml String @default("")

  // Live copy — what the public site renders. Set on publish.
  publishedTitle       String?
  publishedDescription String?
  publishedJson        Json?
  publishedHtml        String?

  authorId   String?
  author     User?   @relation("HelpArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewerId String?
  reviewer   User?   @relation("HelpArticleReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote String?

  submittedAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([status])
}

model HelpSetting {
  id                  String   @id @default("singleton")
  netlifyBuildHookUrl String?
  siteUrl             String?
  updatedAt           DateTime @updatedAt
}
